{
  "version": 1.0,
  "case":
  {
    "mesh_file": "channel.nmsh",
    "output_directory": "results_alloc",
    "output_at_end": true,
    "output_checkpoints": false,
    "output_boundary": false,
    "output_precision": "double",
    "checkpoint_control": "simulationtime",
    "checkpoint_value": 1.0,
    "runtime_statistics": {
      "enabled": false
    },
    "time": {
      "end_time": 1e-2,
      "variable_timestep": true,
      "target_cfl": 0.5,
      "timestep": 1e-3,
      "max_timestep": 0.25e-2
    },
    "numerics": {
      "time_order": 3,
      "polynomial_order": 5,
      "dealias": true
    },

    "FST": {
      "enabled": true,
      "_t_start": 0.15, 
      "Uinf": 1.0,
      "ystart": -0.05,
      "Tu": 3.7e-2,
      "L": 11.53e-3,
      "k_start": 63.77,
      "k_end": 1660.0,
      "n_shells": 80,
      "files_output_path": "fst_alloc",
      "n_pts_per_shell": 40,
      "t_ramp": 0.001,
      "alpha": 0.1,
      "periodic_z": true
    },

    "fluid": {
      "scheme": "pnpn",
      "Re": 3000.0,
      "initial_condition": {
        "type": "uniform",
	      "value": [1.0, 0.0, 0.0]
      },
      "velocity_solver": {
        "type": "cg",
        "preconditioner": {
          "type": "jacobi"
        },
        "absolute_tolerance": 1e-3,
        "max_iterations": 50,
        "projection_space_size": 0
      },
      "pressure_solver": {
        "type": "gmres",
        "preconditioner": {
          "type": "hsmg"
        },
        "projection_space_size": 0,
        "absolute_tolerance": 1e-3,
        "max_iterations": 50
      },
      "output_control": "tsteps",
      "output_value": 5,
      "boundary_conditions": [
        {
          // inflow
          "type": "user_velocity",
          "zone_indices": [1]
        },
        {
        // Outflow with specified pressure distribution
        "type": "outflow+user",
        "zone_indices": [2]
        },
        {
          "type": "no_slip",
          "zone_indices": [3, 4]
        }   
      ]
    }
  }
}
